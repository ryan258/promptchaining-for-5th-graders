# Prompt Chaining Studio — copy to .env if you do not have one.
# Recipes and the authored walkthrough work without credentials.
# Existing .env files are never overwritten by the launcher.

OPENROUTER_API_KEY=""
# Your chosen OpenRouter model IDs, comma separated. Start with the Free Models Router.
OPENROUTER_MODELS="openrouter/free"
# When this is blank, DEFAULT_MODEL can supply a model. With both blank, Studio
# offers OpenRouter Free and the legacy tools keep their historical defaults.
# DEFAULT_MODEL=""

# Enforced per-response limits, shared by the workbench and legacy tools.
MAX_TOKENS=2000
DEFAULT_TEMPERATURE=0.5
REQUEST_TIMEOUT_SECONDS=30

# Optional request attribution.
OPENROUTER_APP_NAME="Prompt Chaining Studio"
# OPENROUTER_SITE_URL="http://localhost:8000"

# Optional absolute location for studio.sqlite3 and its runtime lock.
# Restart the app after changing configuration.
# PROMPT_STUDIO_DATA="/absolute/path/to/my-workspace"
# Display dates in the user's zone, independently of the execution host.
STUDIO_TIMEZONE="America/Chicago"

# The workbench sends each step once. Manual retries can incur another charge.
# Token limits are not dollar budgets. This app does not enforce an account
# spending cap, rate quota, content filter, or response cache.
# Inputs and referenced answers are sent to OpenRouter and your chosen provider
# only when you explicitly run a live chain. Never put secrets in prompt text.
